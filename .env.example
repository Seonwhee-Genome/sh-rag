# Copy to .env (the start scripts do this for you) and adjust.

# --- Models ---------------------------------------------------------------
# Chat model pulled by the start scripts. Any Ollama chat model works; each
# installed one appears in OpenWebUI as "rag/<name>".
CHAT_MODEL=qwen2.5:7b
# Initial embedding model. bge-m3 is multilingual (good for Korean + English).
# Switch it later from the console (http://localhost:8001 → Models).
# EMBED_MODEL, RAG_TOP_K and RAG_SCORE_THRESHOLD are only defaults: once
# changed in the console, data/config/settings.json takes precedence.
EMBED_MODEL=bge-m3

# --- Ollama ---------------------------------------------------------------
# Native Ollama on the host (default, recommended on macOS and Windows):
OLLAMA_BASE_URL=http://host.docker.internal:11434
# The start scripts override this to http://ollama:11434 when you pass
# -DockerOllama / --docker-ollama.

# --- Documents ------------------------------------------------------------
# Host folder watched for documents (PDF, DOCX, HTML, Markdown, text, code).
DOCS_PATH=./data/docs
SCAN_INTERVAL=30
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
QDRANT_COLLECTION=documents

# --- Retrieval ------------------------------------------------------------
RAG_TOP_K=5
# Cosine similarity cut-off (0-1). Lower = more (looser) context.
RAG_SCORE_THRESHOLD=0.35
RAG_MAX_CONTEXT_CHARS=12000
RAG_SHOW_SOURCES=true

# --- Security -------------------------------------------------------------
# Shared secret between OpenWebUI (and native clients) and the gateway.
# Change both before exposing anything beyond localhost.
GATEWAY_API_KEY=sh-rag-local-key
WEBUI_SECRET_KEY=change-me-to-a-random-string
# Optional key for the ingest API and web console. Empty = open (fine for
# localhost). Set it together with BIND_ADDRESS=0.0.0.0; the console asks for
# it once, native clients send it as a Bearer token.
INGEST_API_KEY=

# --- Host ports ------------------------------------------------------------
# Interface the gateway, ingest API and OpenWebUI are published on.
# 127.0.0.1 = this machine only (default). 0.0.0.0 = reachable from phones and
# other devices on your network; set GATEWAY_API_KEY and INGEST_API_KEY first.
BIND_ADDRESS=127.0.0.1
WEBUI_PORT=3000
GATEWAY_PORT=8090
INGEST_PORT=8001
QDRANT_PORT=6333

# --- Client workspace --------------------------------------------------------
# Host folder for the board and conversations database used by native clients
# (see docs/client-api.md).
WORKSPACE_PATH=./data/workspace

# --- Image versions -------------------------------------------------------
OPENWEBUI_VERSION=v0.6.5
QDRANT_VERSION=v1.13.4
OLLAMA_VERSION=0.6.5
LOG_LEVEL=info
